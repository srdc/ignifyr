<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ignifyr</groupId>
        <artifactId>ignifyr_2.13</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ignifyr-connector-sql_2.13</artifactId>
    <packaging>jar</packaging>

    <!--
      Community SQL/JDBC source connector. Contributes a SqlSource reader to the engine through the
      IgnifyrExtension SPI (discovered via META-INF/services). Ships the PostgreSQL driver; other JDBC
      drivers (e.g. DB2) are added on the classpath by the deployment/distribution rather than bundled
      here, so the community jar stays Apache-2.0-clean.
    -->

    <build>
        <sourceDirectory>src/main/scala</sourceDirectory>
        <testSourceDirectory>src/test/scala</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
                <executions>
                    <!-- Unit phase: the no-Docker registration spec only. -->
                    <execution>
                        <id>test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <wildcardSuites>io.ignifyr.connector.sql</wildcardSuites>
                        </configuration>
                    </execution>
                    <!-- Integration phase: the full-pipeline SqlSourceTest (H2 + onFHIR container). -->
                    <execution>
                        <id>integration-test</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <membersOnlySuites>io.ignifyr.integrationtest</membersOnlySuites>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Community edition boundary gate: bans enterprise-only deps (see root pluginManagement). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-enterprise-deps</id>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Engine library: SPI, base reader, models -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-engine_2.13</artifactId>
        </dependency>

        <!-- PostgreSQL driver for Spark JDBC reads -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Shared test harness (IgnifyrTestSpec + OnFhirTestContainer) + classpath fixtures, plus
             scalatest / h2 transitively. Hosts the full-pipeline SqlSourceTest (H2 + onFHIR container). -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-testkit_2.13</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The integration test writes its mapped resources to the onFHIR container, so the
             FHIR-repository sink module must be on the test classpath. -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-sink-fhir_2.13</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
