<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ignifyr</groupId>
        <artifactId>ignifyr_2.13</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ignifyr-runtime-scheduling_2.13</artifactId>
    <packaging>jar</packaging>

    <!--
      Enterprise scheduling runtime: provides cron-driven periodic batch execution as an installable
      capability (SchedulerProvider). The cron4j scheduler, last-synchronization bookkeeping, and the
      scheduled-execution registry all live here, so the community engine carries no scheduling
      dependency. Absent this module, a job with schedulingSettings fails with a clear
      MissingCapabilityException.
    -->

    <build>
        <sourceDirectory>src/main/scala</sourceDirectory>
        <testSourceDirectory>src/test/scala</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
                <executions>
                    <!-- Unit phase: the no-Docker registration spec only. -->
                    <execution>
                        <id>test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <wildcardSuites>io.ignifyr.runtime.scheduling</wildcardSuites>
                        </configuration>
                    </execution>
                    <!-- Integration phase: the full cron/SQL/onFHIR SchedulingTest. -->
                    <execution>
                        <id>integration-test</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <membersOnlySuites>io.ignifyr.integrationtest</membersOnlySuites>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Engine library: SPI (SchedulerProvider), RunningJobRegistry, IFhirMappingJobManager,
             ExecutionLogger, models -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-engine_2.13</artifactId>
        </dependency>

        <!-- cron4j: the scheduler behind this capability -->
        <dependency>
            <groupId>it.sauronsoftware.cron4j</groupId>
            <artifactId>cron4j</artifactId>
        </dependency>

        <!-- Shared test harness (IgnifyrTestSpec + OnFhirTestContainer) + fixtures, plus
             scalatest / mockito / h2 transitively. -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-testkit_2.13</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The behavioural SchedulingTest reads a SqlSource, so the SQL connector must be on the test
             classpath for its reader to be ServiceLoader-discovered. -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-connector-sql_2.13</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
