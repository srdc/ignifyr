<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ignifyr</groupId>
        <artifactId>ignifyr_2.13</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ignifyr-cli_2.13</artifactId>
    <packaging>jar</packaging>

    <!--
      Community CLI distribution. This module owns the runnable standalone jar: it depends on the
      engine library plus the community connector/format plugin modules and shades them into a single
      fat jar (Main-Class io.ignifyr.engine.Boot). The engine itself cannot depend on the connectors
      (they depend on it), so the assembly that bundles them must live downstream, here. Adding a new
      community connector to the distribution is a one-line dependency addition below.
    -->

    <dependencies>
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-engine_2.13</artifactId>
        </dependency>
        <!-- Community source connectors bundled into the standalone distribution -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-connector-sql_2.13</artifactId>
        </dependency>
        <!-- Community file connector (file-system source; csv/tsv/parquet source formats). The
             enterprise JSON-source format module is not bundled here. -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-connector-file_2.13</artifactId>
        </dependency>
        <!-- Community FHIR-repository sink (the flagship output) + its FHIR-server-backed
             terminology/identity service providers -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-sink-fhir_2.13</artifactId>
        </dependency>
        <!-- Community file-system sink (ndjson/csv/parquet sink formats). The enterprise Delta-sink
             format module is not bundled here. -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-sink-file_2.13</artifactId>
        </dependency>

        <!-- Edition-separation guard test -->
        <dependency>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest_${scala.binary.version}</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testSourceDirectory>src/test/scala</testSourceDirectory>
        <plugins>
            <!-- Compiles the test-only Scala separation spec. -->
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
                <configuration>
                    <wildcardSuites>io.ignifyr.test.cli</wildcardSuites>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <finalName>ignifyr-engine-standalone</finalName>
                            <transformers>
                                <!-- add Main-Class to manifest file -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.ignifyr.engine.Boot</mainClass>
                                </transformer>

                                <!-- Append reference.conf to jar configurations for Akka to run -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>reference.conf</resource>
                                </transformer>

                                <!-- Merge META-INF/services so ServiceLoader (Spark data sources AND Ignifyr
                                     extensions from every bundled plugin module) resolves in the fat jar. -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>

                                <!-- Third-party attribution. The fat jar redistributes ~180 jars, 73 of
                                     which ship a META-INF/NOTICE; without these transformers shade keeps
                                     whichever one it processed last and discards the rest. ApacheNotice
                                     merges them all; ApacheLicense drops the dependencies' LICENSE copies
                                     so IncludeResource can state Ignifyr's own, deterministically. -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <projectName>Ignifyr</projectName>
                                    <organizationName>SRDC Corp.</organizationName>
                                    <organizationURL>https://www.srdc.com.tr</organizationURL>
                                    <inceptionYear>2022</inceptionYear>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <file>${project.basedir}/../LICENSE</file>
                                    <resource>META-INF/LICENSE</resource>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Community edition boundary gate: bans enterprise-only deps (see root pluginManagement). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-enterprise-deps</id>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
