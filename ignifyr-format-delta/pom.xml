<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ignifyr</groupId>
        <artifactId>ignifyr_2.13</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ignifyr-format-delta_2.13</artifactId>
    <packaging>jar</packaging>

    <!--
      Enterprise Delta Lake file *sink* format: contributes a FileSinkFormat handler to the file
      sink's format sub-SPI, and (via its IgnifyrExtension) the Spark-session wiring Delta needs
      (spark.sql.extensions + the Delta catalog) through the sparkConfContributions hook. It carries
      the delta-spark dependency, keeping it and the Delta wiring out of the community engine and jar.
      Depends on ignifyr-sink-file for the FileSinkFormat sub-SPI + FileSinkSupport it reuses.
    -->

    <build>
        <sourceDirectory>src/main/scala</sourceDirectory>
        <testSourceDirectory>src/test/scala</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
                <configuration>
                    <wildcardSuites>io.ignifyr.format.delta</wildcardSuites>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- The file sink: the FileSinkFormat sub-SPI + FileSinkSupport this handler reuses
             (brings the engine transitively). -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-sink-file_2.13</artifactId>
        </dependency>

        <!-- Delta Lake for Spark: the runtime behind the Delta sink + the DeltaSparkSessionExtension /
             DeltaCatalog contributed to the Spark session. Kept out of the community engine. -->
        <dependency>
            <groupId>io.delta</groupId>
            <artifactId>delta-spark_${scala.binary.version}</artifactId>
        </dependency>

        <!-- Shared test harness + fixtures + scalatest (transitively). -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-testkit_2.13</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
