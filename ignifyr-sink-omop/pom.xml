<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ignifyr</groupId>
        <artifactId>ignifyr_2.13</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ignifyr-sink-omop_2.13</artifactId>
    <packaging>jar</packaging>

    <!--
      Enterprise OMOP sink — placeholder skeleton reserving the module for the upcoming "map to
      OMOP" feature: an OmopSinkSettings-keyed sink writer typing rows against versioned OMOP CDM
      schemas (5.3/5.4/6.0) with FK-ordered table writes, plus an OMOP-vocabulary-backed terminology
      service. Registers nothing yet; the engine-side model classes (OmopSinkSettings, ...) land
      together with the implementation. Will depend on the generic relational write machinery
      (planned for ignifyr-connector-sql / a sink-sql module) when the feature is built.
    -->

    <build>
        <sourceDirectory>src/main/scala</sourceDirectory>
        <testSourceDirectory>src/test/scala</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
                <executions>
                    <!-- Unit phase: the no-Docker registration spec only. -->
                    <execution>
                        <id>test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <wildcardSuites>io.ignifyr.sink.omop</wildcardSuites>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Engine library: the IgnifyrExtension SPI -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-engine_2.13</artifactId>
        </dependency>

        <!-- Shared test harness (scalatest transitively); hosts the no-Docker registration spec. -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-testkit_2.13</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
