<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Stop output INFO at start -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- Send messages to System.out -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- By default, encoders are assigned the type ch.qos.logback.classic.encoder.PatternLayoutEncoder -->
        <encoder>
            <pattern>%d{yyyy-MM-dd_HH:mm:ss.SSS} [%thread] %-5level %logger{5} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Send messages to a file at "***.log" -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/ignifyr-engine.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d{yyyy-MM-dd_HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</Pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <FileNamePattern>logs/ignifyr-engine.%i.log.zip</FileNamePattern>
            <MinIndex>1</MinIndex>
            <MaxIndex>10</MaxIndex>
        </rollingPolicy>

        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <MaxFileSize>10MB</MaxFileSize>
        </triggeringPolicy>
    </appender>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE" />
    </appender>

    <appender name="FILE-AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/ignifyr-mappings.log</file>
        <!-- Community engine: plain-text mapping/execution audit log. Structured (Logstash JSON)
             audit encoding + Fluentd shipping are provided by the enterprise ignifyr-observability
             module and configured in the server's logback.xml. -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d{yyyy-MM-dd_HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</Pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <FileNamePattern>logs/ignifyr-mappings.%i.log.zip</FileNamePattern>
            <MinIndex>1</MinIndex>
            <MaxIndex>10</MaxIndex>
        </rollingPolicy>

        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <MaxFileSize>10MB</MaxFileSize>
        </triggeringPolicy>
    </appender>

    <appender name="ASYNC-AUDIT" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE-AUDIT" />
    </appender>

    <!-- By default, the level of the root level is set to ERROR -->
    <root level="ERROR">
        <appender-ref ref="ASYNC" />
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="io.ignifyr.engine.data.write.SinkHandler" level="INFO">
        <appender-ref ref="ASYNC-AUDIT" />
    </logger>

    <logger name="io.ignifyr.engine.execution.log.ExecutionLogger">
        <appender-ref ref="ASYNC-AUDIT" />
    </logger>

    <!-- Give me DEBUG level logs from io.ignifyr package because the default is set to ERROR at root (above) -->
    <logger name ="io.ignifyr" level="DEBUG" />

    <!-- Show WARN level logs from org.apache.spark package to see anything going wrong -->
    <logger name="org.apache.spark" level="WARN" />

</configuration>
