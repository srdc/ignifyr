<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ignifyr</groupId>
        <artifactId>ignifyr_2.13</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ignifyr-runtime-streaming_2.13</artifactId>
    <packaging>jar</packaging>

    <!--
      Enterprise streaming runtime: provides Spark structured-streaming execution as an installable
      capability (StreamingExecutionProvider). The community engine can build streaming source
      datasets, but starting/writing the streaming queries lives here. Absent this module, a job with
      a streaming source fails with a clear MissingCapabilityException.
    -->

    <build>
        <sourceDirectory>src/main/scala</sourceDirectory>
        <testSourceDirectory>src/test/scala</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
                <executions>
                    <!-- Unit phase: the no-Docker mechanics spec (StreamingSinkHandlerTest). -->
                    <execution>
                        <id>test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <wildcardSuites>io.ignifyr.runtime.streaming</wildcardSuites>
                        </configuration>
                    </execution>
                    <!-- Integration phase: the folder-watch + Kafka streaming E2E tests (onFHIR + Kafka containers). -->
                    <execution>
                        <id>integration-test</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>${skipITs}</skipTests>
                            <membersOnlySuites>io.ignifyr.integrationtest</membersOnlySuites>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Engine library: SPI (StreamingExecutionProvider, MappingTaskPipeline), SinkHandler,
             FhirWriterFactory, ExecutionLogger, models -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-engine_2.13</artifactId>
        </dependency>

        <dependency>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest_${scala.binary.version}</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-scala_2.13</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Shared test harness (IgnifyrTestSpec + OnFhirTestContainer) + testkit fixtures
             (patient-mapping, Ext-patient schema), plus scalatest / testcontainers transitively. -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-testkit_2.13</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The folder-watch E2E reads a FileSystemSource, so the file connector must be on the
             test classpath for its reader to be ServiceLoader-discovered. -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-connector-file_2.13</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The Kafka E2E reads a KafkaSource, so the Kafka connector (and, transitively,
             spark-sql-kafka + kafka-clients for the test producer) must be on the test classpath. -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-connector-kafka_2.13</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Both E2E tests write to a FhirRepositorySinkSettings. After the sink split the FHIR sink
             writer lives in ignifyr-sink-fhir, so it must be on the test classpath to be
             ServiceLoader-discovered (mirrors connector-file / runtime-scheduling). -->
        <dependency>
            <groupId>io.ignifyr</groupId>
            <artifactId>ignifyr-sink-fhir_2.13</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Kafka broker container for the Kafka streaming E2E (version from testcontainers-bom). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
